<Window x:Class="HisaWarehouse.MaterialRequestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu yêu cầu cấp vật tư dự phòng" Icon="Assets/hisa.ico" Width="1020" Height="820" MinWidth="900" MinHeight="690"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel"><Setter Property="Foreground" Value="#53677F"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B45"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B45"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="36"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock x:Name="Heading" Text="Phiếu yêu cầu cấp vật tư dự phòng" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Chọn vật tư có sẵn hoặc nhập tay vật tư chưa có mã. Phiếu không tự nhập/xuất kho." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16"><StackPanel>
            <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,12"><TextBlock Text="NGÀY YÊU CẦU" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DateBox" SelectedDateFormat="Short"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,8,12"><TextBlock Text="CẦN TRƯỚC NGÀY" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="NeededByBox" SelectedDateFormat="Short"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,8,12"><TextBlock Text="BỘ PHẬN" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DepartmentBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="8,0,0,12"><TextBlock x:Name="RecipientLabel" Text="NGƯỜI NHẬN" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RecipientBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="NGƯỜI YÊU CẦU" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RequesterBox"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0,0,0"><TextBlock Text="GHI CHÚ / LÝ DO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoteBox"/></StackPanel>
            </Grid></Border>
            <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="VẬT TƯ YÊU CẦU" Foreground="#172B45" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ManualEntryCheck" Grid.Column="1" Content="Nhập tay vật tư ngoài danh mục"
                                  Checked="ManualEntry_Changed" Unchecked="ManualEntry_Changed"
                                  Foreground="#2463EB" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHỌN VẬT TƯ TRONG DANH MỤC" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ProductBox" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="SỐ LƯỢNG" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="QuantityBox" Text="1" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Thêm dòng" Click="AddLine_Click" Margin="8,18,0,0" Padding="13,8"
                                Background="#EAF1FF" Foreground="#2463EB" BorderThickness="0" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid x:Name="ManualEntryPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="MÃ VẬT TƯ (KHÔNG BẮT BUỘC)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ManualSkuBox" MaxLength="130" ToolTip="Có thể bỏ trống khi chưa được cấp mã chính thức"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="TÊN VẬT TƯ *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ManualNameBox" MaxLength="300" ToolTip="Tên vật tư cần cấp, nhập tay"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ĐƠN VỊ TÍNH *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ManualUnitBox" IsEditable="True" IsTextSearchEnabled="True"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Vật tư nhập tay chỉ xuất hiện trên phiếu yêu cầu; không tự đăng ký danh mục và không trừ tồn."
                               Foreground="#78899E" FontSize="10.5" Margin="0,9,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="0" MinHeight="290"><DockPanel><Grid DockPanel.Dock="Top" Margin="15,13,15,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DÒNG VẬT TƯ YÊU CẦU" Foreground="#172B45" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="LineCountText" Text="0 mặt hàng" Foreground="#8291A5" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Xóa các dòng" Click="ClearLines_Click" Padding="8,5" Background="Transparent" Foreground="#C94343" BorderThickness="0" FontSize="10"/></Grid><DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" RowHeight="39" ColumnHeaderHeight="34" Background="White" BorderThickness="0" Margin="5,0,5,6"><DataGrid.Columns><DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" Width="110" IsReadOnly="True"/><DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding ItemName}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="115"/><DataGridTemplateColumn Header="" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Xóa" Tag="{Binding}" Click="RemoveLine_Click" Foreground="#C94343" Background="Transparent" BorderThickness="0" FontSize="10"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Padding="16,9" Margin="0,0,9,0" Click="Cancel_Click"/><Button Content="Lưu phiếu yêu cầu" Padding="18,9" Background="#2463EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="Save_Click"/></StackPanel></Border>
    </Grid>
</Window>
