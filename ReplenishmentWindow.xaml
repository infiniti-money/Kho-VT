<Window x:Class="HisaWarehouse.ReplenishmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đề xuất nhập kho" Icon="Assets/hisa.ico"
        Width="1220" Height="770" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel>
                <TextBlock Text="Đề xuất nhập kho" Foreground="#172B45" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="Tổng hợp vật tư dưới mức tồn tối thiểu, trừ số lượng đang chờ nhập theo đề xuất. Chỉ tạo yêu cầu, chưa cộng tồn kho." Foreground="#78899E" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="22,18,22,12" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="KHO CẦN NHẬP" Foreground="#586C84" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                    <ComboBox x:Name="WarehouseBox" SelectionChanged="Warehouse_Changed" Padding="10,7" MinHeight="38"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="NGƯỜI ĐỀ XUẤT" Foreground="#586C84" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                    <TextBox x:Name="RequesterBox" Padding="10,7" MinHeight="38"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="BỘ PHẬN" Foreground="#586C84" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DepartmentBox" IsEditable="True" Padding="10,7" MinHeight="38"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="CẦN TRƯỚC NGÀY" Foreground="#586C84" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                    <DatePicker x:Name="NeededByBox" MinHeight="38"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0">
                    <TextBlock Text="GHI CHÚ ĐỀ XUẤT" Foreground="#586C84" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="NoteBox" Padding="10,7" MinHeight="34"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Foreground="#708198" FontSize="10.5" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="Mức tồn tối thiểu hiện đặt theo mã vật tư và được áp dụng cho kho đang chọn. Vật tư chưa khai báo mức tối thiểu không tự đưa vào đề xuất; kiểm tra các phiếu yêu cầu nhập thủ công trước khi duyệt."/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Margin="22,0,22,12" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,13,16,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="VẬT TƯ CẦN BỔ SUNG" Foreground="#172B45" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="SuggestionCountText" Text="Đang tổng hợp" Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="Chọn tất cả" Click="SelectAll_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Bỏ chọn" Click="ClearAll_Click" Padding="12,7"/>
                </Grid>
                <DataGrid x:Name="SuggestionsGrid" Margin="8,0,8,8" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5"
                          RowHeight="42" ColumnHeaderHeight="40" Background="White" BorderThickness="0"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="CHỌN" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                        <DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" Width="125" IsReadOnly="True"/>
                        <DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="65" IsReadOnly="True"/>
                        <DataGridTextColumn Header="TỒN HIỆN TẠI" Binding="{Binding CurrentText}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="TỒN TỐI THIỂU" Binding="{Binding MinimumText}" Width="115" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ĐANG CHỜ NHẬP" Binding="{Binding PendingText}" Width="115" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SỐ LƯỢNG ĐỀ XUẤT" Binding="{Binding RequestedQuantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="155"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="An tạo phiếu “Chờ duyệt”, bạn sẽ duyệt riêng trước khi xử lý. Không tự cập nhật tồn." Foreground="#78899E" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Quay lại" Click="Cancel_Click" Padding="16,9" Margin="0,0,9,0"/>
                <Button Grid.Column="2" Content="Tạo yêu cầu nhập kho" Click="CreateRequest_Click" Padding="18,9" Background="#2463EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
