<Window x:Class="HisaWarehouse.MaterialRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu yêu cầu cấp vật tư dự phòng" Icon="Assets/hisa.ico" Width="1200" Height="700" MinWidth="1000" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Phiếu yêu cầu cấp vật tư dự phòng" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Chọn vật tư từ danh mục hoặc nhập tay vật tư cần dự phòng. Lưu và duyệt phiếu không thay đổi tồn kho." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Grid.ColumnSpan="2" Content="＋ Tạo phiếu yêu cầu cấp vật tư dự phòng" Click="NewReserveRequest_Click"
                Padding="14,9" Background="#2463EB" Foreground="White" BorderThickness="0"
                FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Margin="22,18,22,14" Padding="0"><DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" RowHeight="40" ColumnHeaderHeight="36" Background="White" BorderThickness="0" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="SỐ YÊU CẦU" Binding="{Binding DocNo}" Width="145"/><DataGridTextColumn Header="NGÀY" Binding="{Binding DateText}" Width="95"/><DataGridTextColumn Header="NỘI DUNG YÊU CẦU" Binding="{Binding Type}" Width="1.3*"/><DataGridTextColumn Header="BỘ PHẬN" Binding="{Binding Department}" Width="1.1*"/><DataGridTextColumn Header="KHO ĐỀ XUẤT" Binding="{Binding Warehouse}" Width="1.1*"/><DataGridTextColumn Header="NGƯỜI YÊU CẦU" Binding="{Binding Requester}" Width="1.2*"/><DataGridTextColumn Header="NGƯỜI NHẬN / NGUỒN" Binding="{Binding Recipient}" Width="1.3*"/><DataGridTextColumn Header="SỐ DÒNG" Binding="{Binding LineCount}" Width="75"/><DataGridTextColumn Header="CẦN TRƯỚC" Binding="{Binding NeededByText}" Width="95"/><DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="115"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CountText" Text="0 yêu cầu" Foreground="#78899E" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="✓ Duyệt yêu cầu" Click="Approve_Click" Margin="0,0,8,0" Padding="14,8" Background="#E8F7F1" Foreground="#138A63" BorderThickness="0"/><Button Grid.Column="2" Content="Đánh dấu hoàn thành" Click="Complete_Click" Margin="0,0,8,0" Padding="14,8"/><Button Grid.Column="3" Content="In phiếu đã chọn" Click="Print_Click" Margin="0,0,8,0" Padding="14,8" Background="#EAF1FF" Foreground="#2463EB" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="4" Content="Đóng" Click="Close_Click" Padding="14,8"/></Grid></Border>
    </Grid>
</Window>
