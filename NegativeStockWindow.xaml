<Window x:Class="HisaWarehouse.NegativeStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cảnh báo tồn âm" Icon="Assets/hisa.ico" Width="1180" Height="720" MinWidth="980" MinHeight="590"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock Text="Cảnh báo chi tiết tồn âm kho" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Danh sách từng mã vật tư và từng kho có số dư nhỏ hơn 0." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        <Grid Grid.Row="1" Margin="22,16,22,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Tìm SKU, tên vật tư hoặc kho" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" Padding="12,8" MinHeight="39" VerticalContentAlignment="Center"/><Border Grid.Column="1" Background="#FDECEC" CornerRadius="8" Padding="12,8" Margin="10,0,0,0"><TextBlock x:Name="CountText" Text="0 cảnh báo" Foreground="#C94343" FontWeight="Bold" VerticalAlignment="Center"/></Border></Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Margin="22,0,22,14" Padding="0"><DataGrid x:Name="AlertsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" RowHeight="40" ColumnHeaderHeight="36" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="KHO" Binding="{Binding Warehouse}" Width="1.1*"/><DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" Width="110"/><DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="NHÓM" Binding="{Binding Category}" Width="1.1*"/><DataGridTextColumn Header="BỘ PHẬN" Binding="{Binding Department}" Width="1*"/><DataGridTextColumn Header="TỒN ÂM" Binding="{Binding StockText}" Width="105"/><DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="MỨC TỐI THIỂU" Binding="{Binding MinimumText}" Width="125"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mỗi dòng tương ứng một SKU tại một kho. Kiểm tra chứng từ hoặc lập phiếu nhập để bù tồn." Foreground="#78899E" FontSize="10.5" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Lập phiếu nhập" Click="Receipt_Click" Margin="0,0,8,0" Padding="14,8" Background="#E8F7F1" Foreground="#138A63" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="2" Content="Đóng" Click="Cancel_Click" Padding="14,8"/></Grid></Border>
    </Grid>
</Window>
