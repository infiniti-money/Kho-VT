<Window x:Class="HisaWarehouse.DetailedReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Báo cáo chi tiết" Icon="Assets/hisa.ico" Width="1450" Height="800" MinWidth="1160" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Báo cáo chi tiết" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Nhập nhiều mã vật tư, lọc thời gian, loại phiếu, kho và xuất Excel." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Xuất báo cáo Excel" Click="Export_Click" Padding="16,9" Background="#2463EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
        <Border Grid.Row="1" Margin="22,13,22,0" Background="#EAF4FF" BorderBrush="#C8DBF5"
                BorderThickness="1" CornerRadius="9" Padding="13,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="LỌC NHIỀU MÃ VẬT TƯ" FontSize="11" FontWeight="Bold" Foreground="#17436A"/>
                    <TextBlock Text="Dùng dấu cách hoặc dấu phẩy để phân tách mã." FontSize="10" Foreground="#527089" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBox x:Name="SkuFilterBox" Grid.Column="1" TextChanged="Filter_Changed"
                         Padding="11,8" MinHeight="39" VerticalContentAlignment="Center"
                         ToolTip="Ví dụ: VT001 VT002,VT003 (lọc chính xác từng mã, không khớp gần đúng)"
                         MaxLength="12000"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="9" Padding="10" Margin="22,12,22,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Tìm SKU, tên, số phiếu, nơi nhận hoặc người làm" Padding="10,7" MinHeight="38"/><ComboBox x:Name="TypeFilter" Grid.Column="1" SelectionChanged="Filter_Changed" Margin="8,0,0,0" Padding="8,5" MinHeight="38"><ComboBoxItem Content="Tất cả loại" IsSelected="True"/><ComboBoxItem Content="Nhập"/><ComboBoxItem Content="Xuất"/><ComboBoxItem Content="Điều chuyển"/><ComboBoxItem Content="Điều chỉnh"/><ComboBoxItem Content="Chưa rõ"/></ComboBox><ComboBox x:Name="WarehouseFilter" Grid.Column="2" SelectionChanged="Filter_Changed" Margin="8,0,0,0" Padding="8,5" MinHeight="38"/><StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Từ ngày" Foreground="#78899E" FontSize="9" Margin="2,0,0,2"/><DatePicker x:Name="FromDate" SelectedDateChanged="Filter_Changed" VerticalContentAlignment="Center"/></StackPanel><StackPanel Grid.Column="4" Margin="8,0,0,0"><TextBlock Text="Đến ngày" Foreground="#78899E" FontSize="9" Margin="2,0,0,2"/><DatePicker x:Name="ToDate" SelectedDateChanged="Filter_Changed" VerticalContentAlignment="Center"/></StackPanel><Button Grid.Column="5" Content="Xóa lọc" Click="ClearFilters_Click" Margin="8,0,0,0" Padding="10,7"/></Grid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Margin="22,0,22,14" Padding="0"><DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" RowHeight="36" ColumnHeaderHeight="36" Background="White" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="NGÀY" Binding="{Binding DateText}" Width="94"/><DataGridTextColumn Header="SỐ PHIẾU" Binding="{Binding DocNo}" Width="130"/><DataGridTextColumn Header="THAM CHIẾU" Binding="{Binding ReferenceNo}" Width="120"/><DataGridTextColumn Header="LOẠI" Binding="{Binding Type}" Width="95"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="92"/><DataGridTextColumn Header="VẬT TƯ" Binding="{Binding ItemName}" Width="1.7*"/><DataGridTextColumn Header="BỘ PHẬN" Binding="{Binding Department}" Width="1*"/><DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding QuantityText}" Width="95"/><DataGridTextColumn Header="KHO" Binding="{Binding Warehouse}" Width="1*"/><DataGridTextColumn Header="KHO NHẬN" Binding="{Binding ToWarehouse}" Width="1*"/><DataGridTextColumn Header="NƠI GIAO NHẬN" Binding="{Binding Partner}" Width="1*"/><DataGridTextColumn Header="NGƯỜI LÀM" Binding="{Binding Operator}" Width="1*"/><DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Note}" Width="1.3*"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SummaryText" Text="0 dòng giao dịch" Foreground="#78899E" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Đóng" Click="Close_Click" Padding="14,8"/></Grid></Border>
    </Grid>
</Window>
