<Window x:Class="HisaWarehouse.ExcelPdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Phiếu in theo mẫu Excel" Width="1160" Height="860"
        MinWidth="800" MinHeight="600" Background="#EEF4F9" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#173D56" Padding="18,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="XEM TRƯỚC PHIẾU IN TỪ EXCEL" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Mẫu gốc: sheet Phiếu in · PDF tạm, không sửa KHO.xlsx" Foreground="#C8E4EC" Margin="0,5,0,0" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Đóng" Click="Close_Click" Padding="17,8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="In từ bản xem trước" Click="Print_Click" Padding="17,8"
                        Background="#168A91" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <wv:WebView2 x:Name="Viewer" Grid.Row="1" Margin="14" Loaded="Viewer_Loaded"/>
    </Grid>
</Window>