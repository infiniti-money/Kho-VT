<Window x:Class="HisaWarehouse.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tìm kiếm nhanh" Icon="Assets/hisa.ico" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources><Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B45"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="42"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock Text="Tìm kiếm nhanh" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Tìm theo mã SKU, barcode, tên vật tư, nhóm hàng hoặc bộ phận." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="9" Padding="12" Margin="22,16,22,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="23" Foreground="#7890A8" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Search_Changed" ToolTip="Nhập SKU, barcode hoặc tên vật tư"/></Grid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Margin="22,0,22,14" Padding="0"><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" RowHeight="52" ColumnHeaderHeight="36" Background="White" BorderThickness="0" SelectionMode="Single" MouseDoubleClick="EditSelected_Click"><DataGrid.Columns><DataGridTemplateColumn Header="ẢNH" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="38" Height="38" Background="#F4F7FB" CornerRadius="5" Padding="2"><Image Source="{Binding Photo}" Stretch="UniformToFill"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" Width="110"/><DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding Name}" Width="2.2*"/><DataGridTextColumn Header="NHÓM" Binding="{Binding Category}" Width="1.2*"/><DataGridTextColumn Header="BỘ PHẬN" Binding="{Binding Department}" Width="1.2*"/><DataGridTextColumn Header="TỔNG TỒN" Binding="{Binding TotalStockText}" Width="105"/><DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="70"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CountText" Text="0 kết quả" Foreground="#78899E" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Sửa vật tư" Click="EditSelected_Click" Margin="0,0,8,0" Padding="14,8"/><Button Grid.Column="2" Content="Phiếu nhập" Click="ReceiptSelected_Click" Margin="0,0,8,0" Padding="14,8" Background="#E8F7F1" Foreground="#138A63" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="3" Content="Phiếu xuất" Click="ShipmentSelected_Click" Margin="0,0,8,0" Padding="14,8" Background="#FFF3E7" Foreground="#B06C0B" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="4" Content="Đóng" Click="Cancel_Click" Padding="14,8"/></Grid></Border>
    </Grid>
</Window>
