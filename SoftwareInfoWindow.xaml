<Window x:Class="HisaWarehouse.SoftwareInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin phần mềm" Icon="Assets/hisa.ico" Width="580" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources><Style TargetType="Border" x:Key="Panel"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E9F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,20"><StackPanel Orientation="Horizontal"><Border Width="54" Height="54" CornerRadius="10" ClipToBounds="True" Background="White" BorderBrush="#E3E9F1" BorderThickness="1"><Image Source="Assets/hisa_logo.png" Stretch="UniformToFill"/></Border><StackPanel Margin="14,3,0,0" VerticalAlignment="Center"><TextBlock Text="Thông tin phần mềm" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Thông tin liên hệ và tác giả" Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="24,22" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Tên phần mềm" Foreground="#78899E" FontSize="12" Margin="0,8"/><TextBlock Grid.Column="1" Text="Quản lý kho" Foreground="#172B45" FontSize="14" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Row="1" Text="Người tạo" Foreground="#78899E" FontSize="12" Margin="0,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Trịnh Phương Tân" Foreground="#172B45" FontSize="14" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Row="2" Text="SĐT" Foreground="#78899E" FontSize="12" Margin="0,8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="0867899987" Foreground="#172B45" FontSize="14" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Row="3" Text="Email" Foreground="#78899E" FontSize="12" Margin="0,8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="infinitimoney@icloud.com" Foreground="#2463EB" FontSize="14" FontWeight="SemiBold" Margin="0,8"/></Grid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><Button Content="Đóng" Click="Close_Click" Padding="16,8" HorizontalAlignment="Right"/></Border>
    </Grid>
</Window>
