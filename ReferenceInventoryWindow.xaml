<Window x:Class="HisaWarehouse.ReferenceInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đối chiếu tồn Bravo và KHO.xlsx" Icon="Assets/hisa.ico" Width="1160" Height="720" MinWidth="980" MinHeight="590"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Grid Background="#F3F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel>
                <TextBlock Text="Đối chiếu tồn KHO.xlsx ↔ tổng hợp Bravo theo mã hàng" Foreground="#172B45" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="SourceText" Text="Tệp tham chiếu" Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,14,22,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Chế độ: chỉ đọc" Foreground="#53677F" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="WarehouseBox" Grid.Column="1" MinHeight="34" Padding="8,4"/>
            <TextBlock Grid.Column="2" Text="Kết quả chỉ đọc, giữ cả tồn âm; không sửa dữ liệu hai file." Foreground="#78899E" FontSize="11" VerticalAlignment="Center" Margin="14,0,10,0" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="SelectDifferencesButton" Grid.Column="3" Content="Chọn SKU lệch" Click="SelectDifferences_Click" Padding="12,8" Margin="4,0"/>
            <Button Grid.Column="5" Content="Xuất đối chiếu Excel" Click="ExportBravoComparison_Click"
                    Padding="12,8" Margin="4,0" Background="#E6F2FA"
                    Foreground="#194D76" BorderBrush="#B7D8EA"/>
            <Button x:Name="ApplyButton" Grid.Column="4" Content="Áp dụng tồn đề xuất" Click="ApplySelected_Click" Padding="14,8" Margin="4,0" Background="#3659A8" Foreground="White" BorderBrush="#3659A8" FontWeight="SemiBold"/>
            <Border Grid.Row="1" Grid.ColumnSpan="6" Background="#EEF4FF" CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
                <TextBlock Text="Bravo: cột A mã hàng, B tên, C đơn vị, L tồn (bao gồm số âm). So sánh với tồn từ KHO.xlsx; không tự điều chỉnh." Foreground="#385A88" FontSize="11"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Margin="22,0,22,14" Padding="0">
            <DataGrid x:Name="ComparisonGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDF1F5" RowHeight="40" ColumnHeaderHeight="36" Background="White" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" IsReadOnly="True" Width="115"/>
                    <DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" IsReadOnly="True" Width="65"/>
                    <DataGridTextColumn Header="TỒN FILE CHÍNH" Binding="{Binding AppStockText}" IsReadOnly="True" Width="110"/>
                    <DataGridTextColumn Header="TỒN BRAVO" Binding="{Binding ActualStockText}" IsReadOnly="True" Width="105"/>
                    <DataGridTextColumn Header="CHÊNH LỆCH" Binding="{Binding DifferenceText}" IsReadOnly="True" Width="105"/>
                    <DataGridTextColumn Visibility="Collapsed" Header="TỒN ĐỀ XUẤT" Binding="{Binding ProposedStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="115">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#254D97"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="KẾT QUẢ" Binding="{Binding Status}" IsReadOnly="True" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13">
            <Grid>
                <TextBlock x:Name="SummaryText" Text="Đang đối chiếu" Foreground="#53677F" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="Đóng trang" Click="Close_Click" Padding="14,8" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
