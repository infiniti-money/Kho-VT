<Window x:Class="HisaWarehouse.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin vật tư" Icon="Assets/hisa.ico" Width="760" Height="800" MinWidth="700" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel"><Setter Property="Foreground" Value="#53677F"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B45"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="37"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B45"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="37"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel><TextBlock x:Name="WindowHeading" Text="Thêm vật tư" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Thông tin, bộ phận, hình ảnh, cảnh báo và số dư theo từng kho" Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>
                <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,13">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,9,13"><TextBlock Text="MÃ SKU" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SkuBox" TextChanged="SkuTextChanged"/><Button Grid.Column="1" x:Name="GenerateSkuButton" Content="Tạo mã" Margin="7,0,0,0" Padding="10,4" Click="GenerateSku_Click"/></Grid></StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="9,0,0,13"><TextBlock Text="TÊN VẬT TƯ" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,9,13"><TextBlock Text="NHÓM HÀNG" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CategoryBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="9,0,0,13"><TextBlock Text="ĐƠN VỊ TÍNH" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UnitBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,9,0"><TextBlock Text="BỘ PHẬN" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DepartmentBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="TỒN TỐI THIỂU" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MinimumBox"/></StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,13">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="96" Height="96" Background="#F4F7FB" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="9" Padding="4"><Image x:Name="ProductPhoto" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="ẢNH VẬT TƯ" Foreground="#172B45" FontSize="12" FontWeight="Bold"/><TextBlock Text="Ảnh được nén và lưu cùng dữ liệu sao lưu. Mỗi ảnh tối đa 160 KB." Foreground="#8291A5" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Chọn ảnh" Click="ChoosePhoto_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Gỡ ảnh" Click="RemovePhoto_Click" Padding="12,7"/></StackPanel></StackPanel></Grid>
                </Border>

                <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,13">
                    <StackPanel><TextBlock Text="SỐ DƯ THEO KHO" Foreground="#172B45" FontSize="12" FontWeight="Bold"/><TextBlock Text="Tồn kho từng vị trí. Thay đổi số dư tại đây sẽ không tạo phiếu giao dịch." Foreground="#8291A5" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,10"/><StackPanel x:Name="WarehouseStockPanel"/></StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="17">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MÃ VẠCH CODE 39" Foreground="#172B45" FontSize="12" FontWeight="Bold"/><TextBlock Text="Mã vạch tự động gắn với mã vật tư. Không cho phép chỉnh sửa." Foreground="#8291A5" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,10"/><TextBox x:Name="BarcodeBox" IsReadOnly="True" Focusable="False" TextChanged="BarcodeTextChanged"
                                  Background="#F3F6FA" ToolTip="Mã vạch được lấy tự động từ mã vật tư; không thể sửa."/><TextBlock Text="Chỉ hỗ trợ A–Z, 0–9 và dấu gạch ngang trong mã vạch." Foreground="#8291A5" FontSize="9.5" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="#FAFBFD" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0" Padding="6" VerticalAlignment="Center"><Image x:Name="BarcodePreview" Height="72" Stretch="Uniform"/></Border></Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="24,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Padding="16,9" Margin="0,0,9,0" Click="Cancel_Click"/><Button Content="Lưu vật tư" Background="#2463EB" Foreground="White" BorderThickness="0" Padding="17,9" FontWeight="SemiBold" Click="Save_Click"/></StackPanel>
        </Border>
    </Grid>
</Window>
