<Window x:Class="HisaWarehouse.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước phiếu in" Icon="Assets/hisa.ico" Width="1120" Height="820"
        MinWidth="850" MinHeight="600" FontFamily="Segoe UI" Background="#EDF3F9">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#173D56" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="XEM TRƯỚC PHIẾU IN" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock x:Name="DescriptionText" Foreground="#C9E3ED" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="◀ Trước" Command="NavigationCommands.PreviousPage" CommandTarget="{Binding ElementName=PrintViewer}" Padding="12,9" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Sau ▶" Command="NavigationCommands.NextPage" CommandTarget="{Binding ElementName=PrintViewer}" Padding="12,9" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="Quay lại" Padding="18,9" Margin="0,0,9,0"
                        Click="Close_Click" VerticalAlignment="Center"/>
                <Button Grid.Column="4" Content="In phiếu" Background="#168A91" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" Padding="19,9"
                        Click="Print_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" Margin="22" BorderBrush="#CFDDEA" BorderThickness="1" Padding="10">
            <FlowDocumentPageViewer x:Name="PrintViewer" Zoom="78"/>
        </Border>
    </Grid>
</Window>