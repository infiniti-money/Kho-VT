<Window x:Class="HisaWarehouse.CatalogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý danh mục" Icon="Assets/hisa.ico" Width="850" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B45"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E9F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#243A53"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock Text="Quản lý danh mục" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Thêm hoặc bớt kho hàng, đơn vị tính, bộ phận và nơi giao nhận." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        <TabControl Grid.Row="1" Margin="22,18" Background="Transparent" BorderThickness="0">
            <TabItem Header="Kho hàng"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="WarehouseList"/><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WarehouseInput"/><Button Grid.Column="1" Content="Thêm kho" Tag="warehouses" Click="Add_Click" Margin="8,0,0,0" Padding="14,7" Background="#EAF1FF" Foreground="#2463EB" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="2" Content="Bớt kho" Tag="warehouses" Click="Remove_Click" Margin="8,0,0,0" Padding="14,7" Foreground="#C94343"/></Grid></Grid></TabItem>
            <TabItem Header="Đơn vị tính"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="UnitList"/><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UnitInput"/><Button Grid.Column="1" Content="Thêm đơn vị" Tag="units" Click="Add_Click" Margin="8,0,0,0" Padding="14,7" Background="#EAF1FF" Foreground="#2463EB" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="2" Content="Bớt đơn vị" Tag="units" Click="Remove_Click" Margin="8,0,0,0" Padding="14,7" Foreground="#C94343"/></Grid></Grid></TabItem>
            <TabItem Header="Bộ phận"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="DepartmentList"/><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DepartmentInput"/><Button Grid.Column="1" Content="Thêm bộ phận" Tag="departments" Click="Add_Click" Margin="8,0,0,0" Padding="14,7" Background="#EAF1FF" Foreground="#2463EB" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="2" Content="Bớt bộ phận" Tag="departments" Click="Remove_Click" Margin="8,0,0,0" Padding="14,7" Foreground="#C94343"/></Grid></Grid></TabItem>
            <TabItem Header="Người nhận hàng"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="RecipientList"/><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RecipientInput"/><Button Grid.Column="1" Content="Thêm nơi nhận" Tag="recipients" Click="Add_Click" Margin="8,0,0,0" Padding="14,7" Background="#EAF1FF" Foreground="#2463EB" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="2" Content="Bớt nơi nhận" Tag="recipients" Click="Remove_Click" Margin="8,0,0,0" Padding="14,7" Foreground="#C94343"/></Grid></Grid></TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Đóng" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/><Button Content="Lưu danh mục" Click="Save_Click" Padding="17,8" Background="#2463EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/></StackPanel></Border>
    </Grid>
</Window>
