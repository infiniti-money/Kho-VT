<Window x:Class="HisaWarehouse.PendingMovementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu chờ xác nhận" Icon="Assets/hisa.ico" Width="1120" Height="680" MinWidth="950" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock Text="Phiếu nhập / xuất chờ xác nhận" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Phiếu ở trạng thái chờ chưa làm thay đổi tồn kho. Xác nhận để ghi nhận số dư và vào nhật ký." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Grid.Row="1" Background="#FFF7E9" BorderBrush="#F4E2C2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="22,16,22,12"><TextBlock x:Name="CountText" Text="0 phiếu chờ" Foreground="#85591A" FontSize="11" FontWeight="SemiBold"/></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Margin="22,0,22,14" Padding="0"><DataGrid x:Name="PendingGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" RowHeight="40" ColumnHeaderHeight="36" Background="White" BorderThickness="0" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="NGÀY" Binding="{Binding DateText}" Width="95"/><DataGridTextColumn Header="SỐ PHIẾU" Binding="{Binding DocNo}" Width="145"/><DataGridTextColumn Header="LOẠI" Binding="{Binding Type}" Width="105"/><DataGridTextColumn Header="SỐ DÒNG" Binding="{Binding LineCount}" Width="80"/><DataGridTextColumn Header="KHO" Binding="{Binding Warehouse}" Width="1.1*"/><DataGridTextColumn Header="KHO NHẬN" Binding="{Binding ToWarehouse}" Width="1*"/><DataGridTextColumn Header="NƠI GIAO / NHẬN" Binding="{Binding Partner}" Width="1.2*"/><DataGridTextColumn Header="NGƯỜI LẬP" Binding="{Binding Operator}" Width="1*"/><DataGridTextColumn Header="GHI CHÚ" Binding="{Binding Note}" Width="1.4*"/></DataGrid.Columns></DataGrid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Khi xác nhận phiếu xuất, hệ thống kiểm tra lại số tồn hiện có." Foreground="#78899E" FontSize="10.5" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Hủy phiếu chờ" Click="CancelPending_Click" Margin="0,0,8,0" Padding="14,8" Foreground="#C94343"/><Button Grid.Column="2" Content="Xác nhận &amp; cập nhật tồn" Click="Confirm_Click" Margin="0,0,8,0" Padding="14,8" Background="#2463EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/><Button Grid.Column="3" Content="Đóng" Click="Close_Click" Padding="14,8"/></Grid></Border>
    </Grid>
</Window>
