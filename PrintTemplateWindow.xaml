<Window x:Class="HisaWarehouse.PrintTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa mẫu in" Icon="Assets/hisa.ico" Width="760" Height="760" MinWidth="680" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources><Style TargetType="TextBlock" x:Key="Label"><Setter Property="Foreground" Value="#53677F"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172B45"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="37"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></Window.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock Text="Chỉnh sửa mẫu in phiếu" Foreground="#172B45" FontSize="20" FontWeight="Bold"/><TextBlock Text="Các thay đổi được lưu trên máy và áp dụng cho phiếu in mới." Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18"><StackPanel>
            <TextBlock Text="LOẠI PHIẾU" Style="{StaticResource Label}"/><ComboBox x:Name="TypeBox" SelectionChanged="Type_Changed" Padding="9,6" MinHeight="38"/>
            <Border Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,14,0,0"><StackPanel>
                <TextBlock Text="TÊN ĐƠN VỊ / CÔNG TY" Style="{StaticResource Label}"/><TextBox x:Name="OrganizationBox" Margin="0,0,0,12"/>
                <TextBlock Text="TIÊU ĐỀ PHIẾU" Style="{StaticResource Label}"/><TextBox x:Name="TitleBox" Margin="0,0,0,12"/>
                <TextBlock Text="DÒNG THÔNG TIN ĐẦU PHIẾU" Style="{StaticResource Label}"/><TextBox x:Name="HeaderNoteBox" Margin="0,0,0,12"/>
                <TextBlock Text="GHI CHÚ CUỐI PHIẾU" Style="{StaticResource Label}"/><TextBox x:Name="FooterNoteBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="62" VerticalContentAlignment="Top" Margin="0,0,0,12"/>
                <TextBlock Text="CHỮ KÝ 1" Style="{StaticResource Label}"/><TextBox x:Name="Signer1Box" Margin="0,0,0,12"/>
                <TextBlock Text="CHỮ KÝ 2" Style="{StaticResource Label}"/><TextBox x:Name="Signer2Box" Margin="0,0,0,12"/>
                <TextBlock Text="CHỮ KÝ 3" Style="{StaticResource Label}"/><TextBox x:Name="Signer3Box"/>
            </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0" Padding="22,13"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/><Button Content="Lưu mẫu in" Click="Save_Click" Padding="17,8" Background="#2463EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/></StackPanel></Border>
    </Grid>
</Window>
