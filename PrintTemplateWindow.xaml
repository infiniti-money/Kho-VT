<Window x:Class="HisaWarehouse.PrintTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết kế mẫu phiếu in" Icon="Assets/hisa.ico"
        Width="1330" Height="850" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#F0F5FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#47617C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderBrush" Value="#DCE6F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#153951" Padding="24,18">
            <StackPanel>
                <TextBlock Text="THIẾT KẾ MẪU PHIẾU IN" Foreground="#FFFFFF" FontWeight="Bold" FontSize="21"/>
                <TextBlock Text="Phiếu Nhập/Xuất in theo sheet Phiếu in trong KHO.xlsx; chỉnh trực tiếp mẫu đó bằng Excel. Các mẫu tại đây dùng cho phiếu yêu cầu HISA."
                           Foreground="#C8E4ED" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DEE7F2" BorderThickness="1" CornerRadius="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="17">
                    <StackPanel>
                        <TextBlock Text="CHỌN MẪU PHIẾU" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TypeBox" SelectionChanged="Type_Changed" MinHeight="36"/>
                        <Grid Margin="0,8,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTypeBox" Grid.Column="0" ToolTip="Tên mẫu mới" MaxLength="80"/>
                            <Button Grid.Column="1" Content="+ Thêm" Click="Add_Click" Margin="7,0,0,0" Padding="10,7"/>
                            <Button Grid.Column="2" Content="Xóa mẫu" Click="Delete_Click" Margin="7,0,0,0" Padding="10,7"/>
                        </Grid>
                        <TextBlock Text="NỘI DUNG PHIẾU" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Tên đơn vị"/><TextBox x:Name="OrganizationBox" Margin="0,5,0,9"/>
                        <TextBlock Text="Tiêu đề phiếu"/><TextBox x:Name="TitleBox" Margin="0,5,0,9"/>
                        <TextBlock Text="Dòng đầu phiếu"/><TextBox x:Name="HeaderNoteBox" Margin="0,5,0,9"/>
                        <TextBlock Text="Ghi chú cuối phiếu"/><TextBox x:Name="FooterNoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="65" Margin="0,5,0,9"/>
                        <Grid Margin="0,3,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Chữ ký 1"/><TextBox x:Name="Signer1Box" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Chữ ký 2"/><TextBox x:Name="Signer2Box" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Chữ ký 3"/><TextBox x:Name="Signer3Box" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="CĂN CHỈNH GIỐNG EXCEL" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Phông chữ"/><ComboBox x:Name="FontBox" Margin="0,5,0,10" MinHeight="35">
                                    <ComboBoxItem Content="Arial"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Times New Roman"/>
                                </ComboBox>
                                <!-- Legacy symmetric margin retained for older saved templates; use four visible margins below. -->
                                <TextBox x:Name="MarginBox" Visibility="Collapsed"/>
                                <TextBlock Text="Căn tiêu đề"/><ComboBox x:Name="AlignBox" Margin="0,5,0,10" MinHeight="35">
                                    <ComboBoxItem Content="Trái" Tag="Left"/><ComboBoxItem Content="Giữa" Tag="Center"/><ComboBoxItem Content="Phải" Tag="Right"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cỡ chữ"/><TextBox x:Name="FontSizeBox" Margin="0,5,0,10"/>
                                <TextBlock Text="Đệm ô bảng (px)"/><TextBox x:Name="CellPaddingBox" Margin="0,5,0,10"/>
                                <TextBlock Text="Khổ giấy"/>
                                <ComboBox x:Name="PaperBox" Margin="0,5,0,10" MinHeight="35" SelectionChanged="Paper_Changed">
                                    <ComboBoxItem Content="A4" Tag="A4"/>
                                    <ComboBoxItem Content="A5" Tag="A5"/>
                                    <ComboBoxItem Content="A6" Tag="A6"/>
                                    <ComboBoxItem Content="Letter" Tag="Letter"/>
                                    <ComboBoxItem Content="Cuộn 58mm" Tag="58mm"/>
                                    <ComboBoxItem Content="Cuộn 80mm" Tag="80mm"/>
                                    <ComboBoxItem Content="Tùy chỉnh" Tag="Tùy chỉnh"/>
                                </ComboBox>
                                <CheckBox x:Name="LandscapeCheck" Content="Hướng ngang" Margin="0,3,0,10"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#F5F9FD" BorderBrush="#DEE7F2" BorderThickness="1" Padding="10" CornerRadius="7" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="THIẾT LẬP TRANG IN" Style="{StaticResource FieldLabel}"/>
                                <StackPanel x:Name="CustomPaperPanel" Visibility="Collapsed">
                                    <TextBlock Text="Khổ tùy chỉnh (mm): chiều rộng / chiều cao"/>
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="CustomWidthBox" Grid.Column="0"/>
                                        <TextBox x:Name="CustomHeightBox" Grid.Column="2"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Text="Lề trên / dưới / trái / phải (mm)"/>
                                <UniformGrid Columns="4" Margin="0,5,0,10">
                                    <TextBox x:Name="TopMarginBox" Margin="0,0,4,0" ToolTip="Trên"/>
                                    <TextBox x:Name="BottomMarginBox" Margin="4,0,4,0" ToolTip="Dưới"/>
                                    <TextBox x:Name="LeftMarginBox" Margin="4,0,4,0" ToolTip="Trái"/>
                                    <TextBox x:Name="RightMarginBox" Margin="4,0,0,0" ToolTip="Phải"/>
                                </UniformGrid>
                                <TextBlock Text="Máy in mặc định cho mẫu này"/>
                                <ComboBox x:Name="PrinterBox" IsEditable="True" IsTextSearchEnabled="True" MinHeight="35" Margin="0,5,0,9"/>
                                <TextBlock Text="Số bản in"/>
                                <TextBox x:Name="CopiesBox" Text="1" Margin="0,5,0,0"/>
                                <Button Content="Khôi phục thiết lập trang mặc định" Click="ResetPage_Click"
                                        Padding="10,7" Margin="0,9,0,0"/>
                                <TextBlock Text="Máy in phải hỗ trợ khổ giấy đã chọn. Phiếu Nhập/Xuất dựa trên mẫu Excel gốc không bị thay đổi."
                                           Foreground="#7A5960" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="↻ Cập nhật bản xem trước" Click="Preview_Click"
                                Background="#168A91" Foreground="White" Padding="14,11"
                                BorderThickness="0" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="EditorStatus" Foreground="#B45E27" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#E6EEF7" BorderBrush="#C6D7E8"
                    BorderThickness="1" CornerRadius="13" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewHeading" Text="XEM TRƯỚC BẢN IN" Foreground="#294E6A"
                               FontSize="13" FontWeight="Bold" Margin="8,3,0,12"/>
                    <Border Grid.Row="1" Background="White" BorderBrush="#CAD5E3" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <FlowDocumentPageViewer x:Name="PreviewViewer" Zoom="75"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                                <Button Content="◀ Trang trước" Command="NavigationCommands.PreviousPage" CommandTarget="{Binding ElementName=PreviewViewer}" Padding="12,7" Margin="0,0,8,0"/>
                                <Button Content="Trang sau ▶" Command="NavigationCommands.NextPage" CommandTarget="{Binding ElementName=PreviewViewer}" Padding="12,7"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" Padding="22,12" BorderBrush="#DCE6F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Click="Cancel_Click" Padding="16,9" Margin="0,0,9,0"/>
                <Button Content="Lưu các mẫu in" Click="Save_Click" Padding="20,9"
                        Foreground="White" Background="#168A91" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>