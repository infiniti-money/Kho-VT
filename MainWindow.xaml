<Window x:Class="HisaWarehouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Quản lý kho · HISA" Icon="Assets/hisa.ico" Width="1510" Height="930" MinWidth="1240" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C1CCDA" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#213A57" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E9F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="Foreground" Value="#172B45" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SmallCaption">
            <Setter Property="Foreground" Value="#78899E" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBox" x:Key="SearchBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#172B45" />
            <Setter Property="BorderBrush" Value="#E3E9F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" x:Key="FilterCombo">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#172B45" />
            <Setter Property="BorderBrush" Value="#E3E9F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="39" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#10283D">
            <Grid Margin="18,18,18,16">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,5,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,2,0,30">
                        <Border Width="40" Height="40" CornerRadius="12" Background="White" VerticalAlignment="Center" ClipToBounds="True">
                            <Image Source="Assets/hisa_logo.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HISA" Foreground="White" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="QUẢN LÝ KHO" Foreground="#92A6BD" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="CHỨC NĂNG" Foreground="#93ACC2" FontSize="10" FontWeight="Bold" Margin="8,0,0,9"/>
                    <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Click="NavDashboard_Click" ToolTip="Trang đầu">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="29" FontSize="17"/><TextBlock Text="Trang đầu" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavAi" Style="{StaticResource NavButton}" Click="NavAi_Click" ToolTip="Trò chuyện với An">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Width="29" FontSize="17"/><TextBlock Text="Trò chuyện với An" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavInventory" Style="{StaticResource NavButton}" Click="NavInventory_Click" ToolTip="Danh sách vật tư">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="29" FontSize="17"/><TextBlock Text="Danh sách vật tư" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavMovement" Style="{StaticResource NavButton}" Click="NavMovement_Click" ToolTip="Nhập / xuất kho">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⇄" Width="29" FontSize="17"/><TextBlock Text="Nhập / xuất kho" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavPending" Style="{StaticResource NavButton}" Click="NavPending_Click" ToolTip="Phiếu chờ xác nhận">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="29" FontSize="17"/><TextBlock x:Name="NavPendingText" Text="Phiếu chờ xác nhận" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavReplenishment" Style="{StaticResource NavButton}" Click="NavReplenishment_Click" ToolTip="Đề xuất nhập vật tư">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↥" Width="29" FontSize="17"/><TextBlock Text="Đề xuất nhập vật tư" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavReports" Style="{StaticResource NavButton}" Click="NavReports_Click" ToolTip="Báo cáo chi tiết">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▥" Width="29" FontSize="17"/><TextBlock Text="Báo cáo chi tiết" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavAudit" Style="{StaticResource NavButton}" Click="NavAudit_Click" ToolTip="Nhật ký giao dịch">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="≡" Width="29" FontSize="17"/><TextBlock Text="Nhật ký giao dịch" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavPrintTemplates" Style="{StaticResource NavButton}" Click="NavPrintTemplates_Click" ToolTip="Mẫu in phiếu">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="29" FontSize="17"/><TextBlock Text="Mẫu in phiếu" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavCatalogs" Style="{StaticResource NavButton}" Click="NavCatalogs_Click" ToolTip="Danh mục phân loại hàng hóa, kho, người nhận / gửi">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="☷" Width="29" FontSize="17"/><TextBlock Text="Danh mục hàng hóa / kho" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click" ToolTip="Dữ liệu Excel và sao lưu">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="29" FontSize="17"/><TextBlock Text="Dữ liệu Excel và sao lưu" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1">
                    <Border Background="#1C3552" CornerRadius="10" Padding="13" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#48D49A" VerticalAlignment="Center" />
                                <TextBlock Text="  Dữ liệu lưu trên máy này" Foreground="#E0E9F3" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Nhật ký và số dư được lưu tự động." Foreground="#91A5BC" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#2D4663" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="17" Background="#274664">
                                <TextBlock Text="HY" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Kho Hưng Yên" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Quản lý vật tư" Foreground="#91A5BC" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1">
                <Grid Margin="28,0,28,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BreadcrumbTitle" Text="Tổng quan kho" Foreground="#172B45" FontSize="17" FontWeight="Bold" />
                        <TextBlock x:Name="BreadcrumbSubtitle" Text="Theo dõi tồn kho và luân chuyển vật tư" Foreground="#78899E" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="WarehouseFilterButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="WarehouseFilter_Click" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Margin="0,0,9,0"/><TextBlock x:Name="WarehouseFilterLabel" Text="8 kho đang chọn"/><TextBlock Text="  ▾"/></StackPanel>
                    </Button>
                    <Popup x:Name="WarehousePopup" PlacementTarget="{Binding ElementName=WarehouseFilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False">
                        <Border Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="11" Padding="12" Width="286">
                            <StackPanel>
                                <TextBlock Text="LỌC THEO KHO" Foreground="#708198" FontSize="10" FontWeight="Bold" Margin="6,2,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Button Content="Chọn tất cả" Click="SelectAllWarehouses_Click" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="Bỏ chọn" Click="ClearWarehouses_Click" Style="{StaticResource SecondaryButton}" Padding="9,6" FontSize="11" />
                                </StackPanel>
                                <ItemsControl x:Name="WarehouseChecks" />
                                <TextBlock Text="Bộ lọc ảnh hưởng đến KPI và bảng tồn." Foreground="#8998AA" FontSize="10" Margin="6,9,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="QuickMovement_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Tạo phiếu"/></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="PageHost">
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,24">
                        <Border CornerRadius="15" Background="#163953" Padding="21,18" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="HISA · Trang quản lý kho" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                    <TextBlock x:Name="DashboardDateText" Text="Dữ liệu ban đầu từ KHO.xlsx"
                                               Foreground="#D3E3F0" FontSize="11" Margin="0,6,0,10" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="UpdateStatusText" Text="Chưa kiểm tra phiên bản mới"
                                               Foreground="#C6E7E3" FontSize="11" TextWrapping="Wrap" MaxWidth="660"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="CheckUpdateButton" Content="↻  Cập nhật 1 lần nhấn" Click="CheckUpdate_Click"
                                            Style="{StaticResource PrimaryButton}" Padding="16,10" Margin="0,0,0,7" MinWidth="192"/>
                                    <Button Content="✦  Trò chuyện với An" Click="NavAi_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="16,10" Margin="0,0,0,7"/>
                                    <Button Content="🎙  Trò chuyện rảnh tay" Click="HomeHandsFree_Click"
                                            Style="{StaticResource PrimaryButton}" Padding="16,10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Xu hướng nhập xuất và cơ cấu vật tư" Foreground="#172B45"
                                   FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource Panel}" Padding="6" Height="300" Margin="0,0,0,16">
                        <wv2:WebView2 x:Name="ChartsWebView" DefaultBackgroundColor="#FFFFFF" />
                    </Border>


                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Chức năng chính" Foreground="#172B45" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Mỗi chức năng mở trực tiếp, không cần mở nhóm hay tìm trong menu."
                                           Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Sao lưu dữ liệu" Click="ExportBackup_Click"
                                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,0,0,15">
                        <Button Click="NavInventory_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Danh sách vật tư" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="QuickReceipt_Click" Style="{StaticResource PrimaryButton}" Margin="6,0,6,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="18" Width="26"/><TextBlock Text="Nhập nhanh" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="QuickShipment_Click" Style="{StaticResource PrimaryButton}" Margin="6,0,6,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="−" FontSize="18" Width="26"/><TextBlock Text="Xuất nhanh" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="NavMovement_Click" Style="{StaticResource SecondaryButton}" Margin="6,0,6,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⇄" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Nhập / xuất kho" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="NavPending_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Phiếu chờ xác nhận" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="NavReplenishment_Click" Style="{StaticResource SecondaryButton}" Margin="6,0,6,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="↥" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Đề xuất nhập vật tư" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="NavReports_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▥" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Báo cáo chi tiết" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="NavAudit_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="≡" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Nhật ký giao dịch" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="NavPrintTemplates_Click" Style="{StaticResource SecondaryButton}" Margin="6,0,6,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Mẫu in phiếu" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        <Button Click="NavSettings_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Padding="11,12" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Foreground="#157F86" Width="26"/><TextBlock Text="Dữ liệu Excel / sao lưu" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                        </Button>
                        </UniformGrid>
                        <TextBlock Text="Tình trạng kho hiện tại" Foreground="#172B45" FontSize="18"
                                   FontWeight="Bold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="MÃ HÀNG ĐANG QUẢN LÝ" Foreground="#78899E" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="KpiProductCount" Text="0" Foreground="#172B45" FontSize="22" FontWeight="Bold" Margin="0,9,0,3"/><TextBlock Text="Mã đang hoạt động trong kho đã chọn" Foreground="#8998AA" FontSize="10"/></StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="#EAF1FF" VerticalAlignment="Top"><TextBlock Text="₫" Foreground="#2463EB" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="5,0,5,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CẢNH BÁO TỒN THẤP" Foreground="#78899E" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="KpiLowStock" Text="0" Foreground="#C47B12" FontSize="24" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="Mã còn hàng dưới mức tối thiểu" Foreground="#8998AA" FontSize="10"/></StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="#FFF5E5" VerticalAlignment="Top"><TextBlock Text="!" Foreground="#C47B12" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="5,0,5,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="HẾT HÀNG / ÂM KHO" Foreground="#78899E" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="KpiOutOfStock" Text="0" Foreground="#C94343" FontSize="24" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock x:Name="KpiOutOfStockCaption" Text="Mã có tồn bằng hoặc dưới 0" Foreground="#8998AA" FontSize="10"/></StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="#FDECEC" VerticalAlignment="Top"><TextBlock Text="−" Foreground="#C94343" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="10,0,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="NHẬP / XUẤT HÔM NAY" Foreground="#78899E" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="KpiToday" Text="0 / 0" Foreground="#172B45" FontSize="22" FontWeight="Bold" Margin="0,9,0,3"/><TextBlock x:Name="KpiTodayCaption" Text="Phiếu nhập / phiếu xuất" Foreground="#8998AA" FontSize="10"/></StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="#E8F7F1" VerticalAlignment="Top"><TextBlock Text="⇄" Foreground="#138A63" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </Grid>
                        </Border>
                    </UniformGrid>


                    <Grid Height="245" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="17,14,17,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Cần theo dõi" Style="{StaticResource SectionTitle}"/><TextBlock Text="Tồn thấp và mặt hàng đã hết" Style="{StaticResource SmallCaption}" Margin="0,3,0,0"/></StackPanel>
                                    <Button Grid.Column="1" Content="Mở danh mục  →" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="10" Click="NavInventory_Click" />
                                </Grid>
                                <DataGrid x:Name="LowStockGrid" Style="{StaticResource ProfessionalGrid}" IsReadOnly="True" SelectionMode="Single" RowHeight="34" ColumnHeaderHeight="32" BorderThickness="0" Margin="6,0,6,6">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã hàng" Binding="{Binding Sku}" Width="95" />
                                        <DataGridTextColumn Header="Tên vật tư" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Tồn" Binding="{Binding StockText}" Width="90" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="17">
                            <StackPanel>
                                <TextBlock Text="Chất lượng dữ liệu nguồn" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="DataQualitySummary" Text="Đang kiểm tra dữ liệu nhập từ Excel." Foreground="#586C84" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                                <Border Background="#FFF7E9" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                    <TextBlock x:Name="DataQualityDetail" Text="Số dư KHO.xlsx được nhập vào Kho tổng. Các kho con bắt đầu ở 0." Foreground="#85591A" FontSize="10.5" TextWrapping="Wrap" />
                                </Border>
                                <Button Content="Xem chi tiết nguồn" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="10,6" FontSize="10" Margin="0,11,0,0" Click="NavSettings_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    </StackPanel>
                </ScrollViewer>

                <TabControl x:Name="InventoryWorkspaceTabs" Margin="24,14,24,18" Visibility="Collapsed">
                    <TabItem Header="Danh sách vật tư · Tra cứu · Tem mã vạch">
                <Grid x:Name="InventoryPage" Margin="4,10,4,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,17">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Danh mục tồn kho" Foreground="#172B45" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="InventoryCountText" Text="460 mã hàng" Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Mẫu Excel" Click="ExportExcelTemplate_Click" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Nhập Excel" Click="ImportExcel_Click" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Xuất Excel" Click="ExportInventoryExcel_Click" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Click="AddItem_Click" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="16" Margin="0,0,7,0"/><TextBlock Text="Thêm vật tư"/></StackPanel></Button>
                    </Grid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="InventorySearch" Style="{StaticResource SearchBox}" TextChanged="InventoryFilter_Changed" ToolTip="Tra cứu ngay trong danh sách: mã SKU, mã vạch, tên vật tư hoặc bộ phận" />
                            <ComboBox x:Name="CategoryFilter" Grid.Column="1" Style="{StaticResource FilterCombo}" Margin="8,0,0,0" SelectionChanged="InventoryFilter_Changed" />
                            <ComboBox x:Name="StatusFilter" Grid.Column="2" Style="{StaticResource FilterCombo}" Margin="8,0,0,0" SelectionChanged="InventoryFilter_Changed">
                                <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/><ComboBoxItem Content="Đủ hàng"/><ComboBoxItem Content="Tồn thấp"/><ComboBoxItem Content="Hết hàng"/><ComboBoxItem Content="Âm kho"/>
                            </ComboBox>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="9,0,0,0">
                                <Button Content="Xem tem / mã vạch" Style="{StaticResource SecondaryButton}" Click="ToggleInventoryLabels_Click" Margin="0,0,6,0"/>
                                <Button Content="In tem đã chọn" Style="{StaticResource SecondaryButton}" Click="PrintSelectedLabels_Click"
                                        ToolTip="Chọn các dòng vật tư trong bảng bằng Ctrl/Shift rồi bấm in tem." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
                        <DataGrid x:Name="InventoryGrid" Style="{StaticResource ProfessionalGrid}" ItemsSource="{Binding InventoryRows}" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="InventoryGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ẢNH" Width="56"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="36" Height="36" Background="#F4F7FB" CornerRadius="5" Padding="2"><Image Source="{Binding Photo}" Stretch="UniformToFill"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" Width="100" />
                                <DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="NHÓM" Binding="{Binding Category}" Width="1.1*" />
                                <DataGridTextColumn Header="BỘ PHẬN" Binding="{Binding Department}" Width="1.05*" />
                                <DataGridTextColumn Header="TỒN ĐANG LỌC" Binding="{Binding StockText}" Width="105" />
                                <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="60" />
                                <DataGridTextColumn Header="TỐI THIỂU" Binding="{Binding MinStock, StringFormat={}{0:N0}}" Width="90" />
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="Badge" Background="#E8F7F1" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left"><TextBlock x:Name="BadgeText" Text="{Binding Status}" Foreground="#138A63" FontSize="10" FontWeight="SemiBold"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Status}" Value="Tồn thấp"><Setter TargetName="Badge" Property="Background" Value="#FFF5E5"/><Setter TargetName="BadgeText" Property="Foreground" Value="#B06C0B"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Hết hàng"><Setter TargetName="Badge" Property="Background" Value="#FDECEC"/><Setter TargetName="BadgeText" Property="Foreground" Value="#C94343"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Âm kho"><Setter TargetName="Badge" Property="Background" Value="#C94343"/><Setter TargetName="BadgeText" Property="Foreground" Value="White"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="THAO TÁC" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Sửa" Tag="{Binding Item}" Click="EditItem_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="10" Margin="0,0,5,0"/><Button Content="⋯" Tag="{Binding Item}" Click="DeleteItem_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                <Grid x:Name="LabelsPage" Grid.Row="3" Height="330" Visibility="Collapsed" Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tem &amp; mã vạch" Foreground="#172B45" FontSize="21" FontWeight="Bold"/><TextBlock Text="Chọn nhiều mã hàng, xem trước và in tem Code 39" Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="In tem đã chọn" Style="{StaticResource PrimaryButton}" Click="PrintSelectedLabels_Click" VerticalAlignment="Center"/></Grid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LabelSearch" Style="{StaticResource SearchBox}" TextChanged="LabelFilter_Changed" ToolTip="Tìm mã hoặc tên vật tư"/><ComboBox x:Name="LabelCategoryFilter" Grid.Column="1" Style="{StaticResource FilterCombo}" Margin="8,0,0,0" SelectionChanged="LabelFilter_Changed"/><Button Grid.Column="2" Content="Chọn tất cả đang lọc" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SelectAllLabels_Click"/></Grid></Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="0"><DataGrid x:Name="LabelGrid" Style="{StaticResource ProfessionalGrid}" ItemsSource="{Binding LabelRows}" SelectionMode="Extended" CellEditEnding="LabelGrid_CellEditEnding" CurrentCellChanged="LabelGrid_CurrentCellChanged"><DataGrid.Columns><DataGridCheckBoxColumn Header="CHỌN" Binding="{Binding SelectedForLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" Width="100"/><DataGridTextColumn Header="TÊN VẬT TƯ" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="65"/></DataGrid.Columns></DataGrid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="XEM TRƯỚC TEM" Foreground="#172B45" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="LabelSelectionText" Text="Chưa chọn mã hàng" Foreground="#78899E" FontSize="10" Margin="0,4,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="LabelPreviewPanel" /></ScrollViewer></DockPanel></Border>
                    </Grid>
                </Grid>
                </Grid>
                    </TabItem>
                </TabControl>

                <TabControl x:Name="AuditReportTabs" Margin="24,14,24,18" Visibility="Collapsed">
                    <TabItem Header="Nhật ký giao dịch">
                <Grid x:Name="AuditPage" Margin="4,10,4,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nhật ký giao dịch" Foreground="#172B45" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="AuditCountText" Text="Theo dõi phiếu, kho, nơi giao nhận và người thực hiện" Foreground="#78899E" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="In phiếu từ Excel" Style="{StaticResource SecondaryButton}"
                                Click="PrintExcelSlip_Click" Margin="0,0,10,0"/>
                        <Button Content="＋ Ghi nhận giao dịch" Style="{StaticResource PrimaryButton}"
                                Click="QuickMovement_Click"/>
                    </StackPanel></Grid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AuditSearch" Style="{StaticResource SearchBox}" TextChanged="AuditFilter_Changed" ToolTip="Tìm mã hàng, số phiếu, nơi giao nhận hoặc người thực hiện"/><ComboBox x:Name="AuditTypeFilter" Grid.Column="1" Style="{StaticResource FilterCombo}" Margin="8,0,0,0" SelectionChanged="AuditFilter_Changed"><ComboBoxItem Content="Tất cả giao dịch" IsSelected="True"/><ComboBoxItem Content="Nhập"/><ComboBoxItem Content="Xuất"/><ComboBoxItem Content="Điều chuyển"/><ComboBoxItem Content="Điều chỉnh"/><ComboBoxItem Content="Chưa rõ"/></ComboBox><DatePicker x:Name="AuditDateFilter" Grid.Column="2" SelectedDateChanged="AuditFilter_Changed" Margin="8,0,0,0" VerticalContentAlignment="Center"/><Button Grid.Column="3" Content="Xóa ngày lọc" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearAuditDate_Click"/></Grid></Border>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0"><DataGrid x:Name="AuditGrid" Style="{StaticResource ProfessionalGrid}" IsReadOnly="True" ItemsSource="{Binding AuditRows}"><DataGrid.Columns><DataGridTextColumn Header="NGÀY" Binding="{Binding DateText}" Width="105"/><DataGridTextColumn Header="SỐ PHIẾU / NGUỒN" Binding="{Binding DocNo}" Width="140"/><DataGridTextColumn Header="LOẠI" Binding="{Binding Type}" Width="108"/><DataGridTextColumn Header="MÃ SKU" Binding="{Binding Sku}" Width="98"/><DataGridTextColumn Header="VẬT TƯ" Binding="{Binding ItemName}" Width="2*"/><DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding QuantityText}" Width="95"/><DataGridTextColumn Header="KHO / NƠI NHẬN" Binding="{Binding LocationText}" Width="1.5*"/><DataGridTextColumn Header="NGƯỜI THỰC HIỆN" Binding="{Binding Operator}" Width="130"/></DataGrid.Columns></DataGrid></Border>
                </Grid>
                    </TabItem>
                    <TabItem Header="Báo cáo chi tiết" x:Name="DetailedReportTab">
                        <ContentControl x:Name="ReportDetailHost"/>
                    </TabItem>
                </TabControl>

                <ScrollViewer x:Name="SettingsPage" Margin="28,22,28,22" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dữ liệu Excel và sao lưu" Foreground="#172B45" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="Thông tin nguồn Excel, dữ liệu lưu cục bộ và công cụ phục hồi" Foreground="#78899E" FontSize="11" Margin="0,4,0,17" />
                        <TextBlock x:Name="SystemInfoText" Visibility="Collapsed"/>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Bản sao lưu dữ liệu" Style="{StaticResource SectionTitle}"/><TextBlock Text="Xuất hoặc phục hồi danh mục, số dư theo kho và nhật ký giao dịch." Foreground="#78899E" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Nhập bản sao lưu" Style="{StaticResource SecondaryButton}" Click="ImportBackup_Click" Margin="0,0,8,0"/><Button Content="Xuất bản sao lưu" Style="{StaticResource PrimaryButton}" Click="ExportBackup_Click"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Nguồn dữ liệu ban đầu" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SettingsSourceText" Text="KHO.xlsx" Foreground="#586C84" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="SettingsAuditText" Text="" Foreground="#78899E" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="1 · File kho chính — KHO.xlsx" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Nguồn dữ liệu chuẩn là KHO.xlsx. Ghi phiếu từ HISA và đối chiếu thay đổi đã lưu ở Excel; chỉ sửa công thức từ bản sao lưu đã kiểm chứng." Foreground="#78899E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="PrimaryPathBox" Style="{StaticResource SearchBox}" ToolTip="Đường dẫn file KHO.xlsx gốc, không nằm trong thư mục cài phần mềm"/>
                                    <Button Grid.Column="1" Content="Chọn file kho" Style="{StaticResource SecondaryButton}" Click="BrowsePrimaryFile_Click" Margin="8,0,0,0"/>
                                    <Button Grid.Column="2" Content="Kiểm tra file chính" Style="{StaticResource PrimaryButton}" Click="CheckPrimaryFile_Click" Margin="8,0,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Đồng bộ từ Excel (xem trước)" Style="{StaticResource PrimaryButton}" Click="SynchronizePrimary_Click" Margin="0,0,8,0"/>
                                    <Button Content="Khôi phục công thức từ bản sao" Style="{StaticResource SecondaryButton}" Click="RestorePrimaryFormulas_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="PrimaryWriteStatusText" Text="Chọn KHO.xlsx để kiểm tra. Đồng bộ thay đổi Excel cần xác nhận; không tự ghi đè công thức." Foreground="#9A650D" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="2 · File đối chiếu riêng (chỉ đọc): khớp mã vật tư và số lượng" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ReferencePathBox" Style="{StaticResource SearchBox}" ToolTip="Chọn thư mục chứa Excel hoặc một tệp Excel"/><Button Grid.Column="1" Content="Chọn thư mục" Style="{StaticResource SecondaryButton}" Click="BrowseReferenceFolder_Click" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Chọn tệp" Style="{StaticResource SecondaryButton}" Click="BrowseReferenceFile_Click" Margin="8,0,0,0"/><Button Grid.Column="3" Content="Đối chiếu tồn" Style="{StaticResource PrimaryButton}" Click="CheckReference_Click" Margin="8,0,0,0"/></Grid></Grid></Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Kho đang quản lý" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="SettingsWarehouses" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Border>
                        <Border Background="#EEF4FF" BorderBrush="#D9E6FF" BorderThickness="1" CornerRadius="10" Padding="14"><TextBlock Text="Dữ liệu nhập từ workbook được lưu trong localStorage của hồ sơ WebView2. Dùng bản sao lưu định kỳ khi cần chuyển dữ liệu sang máy khác." Foreground="#385A88" FontSize="11" TextWrapping="Wrap"/></Border>
                    </StackPanel>
                </ScrollViewer>

                <ContentControl x:Name="EmbeddedPageHost" Panel.ZIndex="40" Background="#F3F6FA" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <wv2:WebView2 x:Name="StorageWebView" Grid.Column="1" Grid.Row="1" Width="1" Height="1" Visibility="Hidden" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Border x:Name="ToastBorder" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,26" MaxWidth="620" Background="#172B45" CornerRadius="9" Padding="14,10" Visibility="Collapsed" Panel.ZIndex="50">
            <TextBlock x:Name="ToastText" Text="Đã lưu" Foreground="White" FontSize="12" TextWrapping="Wrap" MaxWidth="590" />
        </Border>
        <Grid x:Name="ConfirmationOverlay" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#260E1E32" Visibility="Collapsed" Panel.ZIndex="60">
            <Border Width="620" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,82,0,0" Background="White" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ConfirmationText" Text="Xác nhận thao tác?" Foreground="#172B45" FontSize="13" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="ConfirmationNoButton" Content="Quay lại" Click="ConfirmationNo_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button x:Name="ConfirmationYesButton" Content="Xác nhận" Click="ConfirmationYes_Click" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
