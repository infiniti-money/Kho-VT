<Window x:Class="HisaWarehouse.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="An · Trợ lý kho HISA" Icon="Assets/hisa.ico" Width="1190" Height="790"
        Background="#F1F5FB" FontFamily="Segoe UI" MinWidth="1000" MinHeight="680">
    <Window.Resources>
        <Style x:Key="AiAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="AiSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28,18,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="18" Padding="23,19" Margin="0,0,0,17">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#123752" Offset="0"/>
                    <GradientStop Color="#215E80" Offset="0.58"/>
                    <GradientStop Color="#3561A8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="✦  AN · TRỢ LÝ KHO VẬT TƯ" Foreground="#ACDCEF"
                               FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Trò chuyện cùng An" Foreground="White"
                               FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="An kiểm tra tồn kho, báo cáo, hỗ trợ lập phiếu và nói tiếng Việt"
                               Foreground="#D8E9FA" FontSize="12" Margin="0,7,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Đóng trang" Click="Close_Click" Padding="16,10"
                        Background="#E8F2FF" Foreground="#164062" BorderThickness="0"
                        FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="306"/><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="White" BorderBrush="#DDE7F2" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TỔNG QUAN KHO" Foreground="#607B97" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Số liệu từ bộ nhớ HISA" Foreground="#8494A8" FontSize="11" Margin="0,4,0,12"/>
                            <UniformGrid Columns="2">
                                <Border Background="#FFF4E5" CornerRadius="10" Margin="0,0,5,0" Padding="12">
                                    <StackPanel><TextBlock Text="Cảnh báo thấp" Foreground="#936A29" FontSize="10"/>
                                        <TextBlock x:Name="LowStockCount" Text="0" Foreground="#9E610E" FontSize="23" FontWeight="Bold"/></StackPanel>
                                </Border>
                                <Border Background="#FCEDEC" CornerRadius="10" Margin="5,0,0,0" Padding="12">
                                    <StackPanel><TextBlock Text="Hết / âm tồn" Foreground="#9D5E58" FontSize="10"/>
                                        <TextBlock x:Name="OutOfStockCount" Text="0" Foreground="#C94343" FontSize="23" FontWeight="Bold"/></StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock x:Name="MovementCountText" Foreground="#607B97" FontSize="11" Margin="0,13,0,12" TextWrapping="Wrap"/>
                            <Button Content="Xem báo cáo nhập / xuất 7–30 ngày" Style="{StaticResource AiSecondary}"
                                    Click="LocalReport_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="An lập đề xuất nhập kho để duyệt" Style="{StaticResource AiAction}"
                                    Click="ReviewProposals_Click" Margin="0,9,0,0" HorizontalAlignment="Stretch"/>
                            <Button Content="🔊 An đọc nội dung mới nhất" Style="{StaticResource AiSecondary}"
                                    Click="ReadAloud_Click" Margin="0,9,0,0" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#DDE7F2" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="KẾT NỐI GEMINI" Foreground="#607B97" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="KeyStatus" Text="Chưa lưu khóa API" FontSize="12" Foreground="#A46730" Margin="0,0,0,10"/>
                            <PasswordBox x:Name="KeyInput" Padding="11,9" FontSize="12" Background="#F8FBFF"
                                         BorderBrush="#DDE7F2" BorderThickness="1" ToolTip="Nhập khóa API, không hiển thị sau khi lưu"/>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,13">
                                <Button Content="Lưu khóa" Style="{StaticResource AiAction}" Click="SaveKey_Click" Margin="0,0,7,0"/>
                                <Button Content="Xóa khóa" Style="{StaticResource AiSecondary}" Click="RemoveKey_Click"/>
                                <Button x:Name="TestGeminiButton" Content="Kiểm tra API" Style="{StaticResource AiSecondary}"
                                        Click="TestGemini_Click" Margin="7,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Khóa mã hóa bằng Windows DPAPI, lưu riêng trong hồ sơ người dùng. Không lưu vào Excel hay gửi lên GitHub."
                                       Foreground="#718499" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EDF6FF" BorderBrush="#D5E7F9" BorderThickness="1" CornerRadius="14" Padding="17">
                        <StackPanel>
                            <TextBlock Text="QUYỀN RIÊNG TƯ &amp; PHÊ DUYỆT" Foreground="#28537E" FontWeight="Bold" FontSize="11"/>
                            <CheckBox x:Name="ShareDataCheck" Margin="0,11,0,10" FontSize="11.5"
                                      Foreground="#315D84" Content="Cho phép gửi số liệu thống kê kho rút gọn tới Gemini"
                                      Checked="Sharing_Changed" Unchecked="Sharing_Changed" />
                            <CheckBox x:Name="SpeakAnswerCheck" FontSize="11.5" Foreground="#315D84"
                                      Content="Đọc câu trả lời bằng giọng Windows" IsChecked="False"/>
                            <TextBlock Margin="0,12,0,0" Foreground="#476D8C" FontSize="10.5" TextWrapping="Wrap"
                                       Text="AI chỉ phân tích và đề xuất. AI không được sửa KHO.xlsx hoặc tự duyệt phiếu."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDE7F2" BorderThickness="1" CornerRadius="14" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Border BorderBrush="#E9EFF6" BorderThickness="0,0,0,1" Padding="19,15">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Trò chuyện với An" FontWeight="Bold" FontSize="15" Foreground="#16314F"/>
                                <TextBlock Text="An hỗ trợ báo cáo, lập đề xuất có duyệt và đọc nội dung"
                                           Foreground="#8293A6" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Xóa hội thoại" Click="ClearChat_Click" Margin="0,0,10,0" Padding="10,7" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#E7F7F1" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                                <TextBlock Text="●  An · AI kho vật tư" FontWeight="SemiBold" FontSize="10.5" Foreground="#177A63"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ChatScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="17,15">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ChatBubble" Background="#F3F7FD" CornerRadius="12"
                                            HorizontalAlignment="Left" MaxWidth="680" Padding="15,12" Margin="0,0,36,12">
                                        <StackPanel>
                                            <TextBlock x:Name="ChatRole" Text="{Binding RoleLabel}" Foreground="#497393"
                                                       FontWeight="Bold" FontSize="10" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="ChatContent" Text="{Binding Text}" Foreground="#213A57"
                                                       TextWrapping="Wrap" FontSize="12.5" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="ChatBubble" Property="Background" Value="#E7F1FF"/>
                                            <Setter TargetName="ChatBubble" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="ChatBubble" Property="Margin" Value="36,0,0,12"/>
                                            <Setter TargetName="ChatRole" Property="Foreground" Value="#2463EB"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="ActivityStatus" Grid.Row="2" Text="Sẵn sàng. Nhập câu hỏi hoặc dùng mic."
                               Foreground="#72859B" FontSize="11" TextWrapping="Wrap"
                               Margin="20,0,18,8"/>
                    <Border Grid.Row="3" BorderBrush="#E9EFF6" BorderThickness="0,1,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="QuestionInput" Grid.Column="0" AcceptsReturn="True" MinHeight="58" MaxHeight="110"
                                     TextWrapping="Wrap" Padding="11" Background="#F8FBFF" BorderBrush="#DDE7F2" BorderThickness="1"
                                     FontSize="12" ToolTip="Nhập câu hỏi về kho vật tư"/>
                            <Button x:Name="MicButton" Grid.Column="1" Content="🎙 Mic" Style="{StaticResource AiSecondary}"
                                    ToolTip="Nhấn để nhận dạng tiếng Việt qua Gemini, tự dừng sau 1,2 giây im lặng. Cần khóa API và Internet."
                                    Click="Microphone_Click" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                            <Button Grid.Column="2" Content="■ Dừng đọc" Style="{StaticResource AiSecondary}"
                                    Click="StopSpeaking_Click" Margin="7,0,0,0" VerticalAlignment="Bottom"/>
                            <Button x:Name="SendButton" Grid.Column="3" Content="Gửi Gemini" Style="{StaticResource AiAction}"
                                    Click="Send_Click" Margin="7,0,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" BorderBrush="#DCE8F0" BorderThickness="0,1,0,0"
                            Background="#F1F9FC" Padding="14,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Micro đầu vào" VerticalAlignment="Center" Foreground="#365F78"
                                           FontSize="11" Margin="0,0,8,0"/>
                                <ComboBox x:Name="InputMicrophoneBox" Grid.Column="1"
                                          DisplayMemberPath="Label" SelectionChanged="MicrophoneSelection_Changed"
                                          Height="31" MinWidth="200" ToolTip="Chọn micro USB, tai nghe hoặc micro laptop."/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Làm mới mic" Click="RefreshMicrophones_Click" Padding="10,5"/>
                                    <Button x:Name="MicrophoneTestButton" Content="Thử mic" Click="TestMicrophone_Click"
                                            Margin="6,0,0,0" Padding="10,5"
                                            ToolTip="Nghe tín hiệu 8 giây ngay trên máy, không gửi lên Gemini."/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Tín hiệu mic" VerticalAlignment="Center"
                                           FontSize="10" Foreground="#53788E" Margin="0,0,9,0"/>
                                <ProgressBar x:Name="MicrophoneLevelBar" Height="9" Width="170" Minimum="0" Maximum="100"/>
                                <TextBlock Text="(di chuyển khi đang nghe)" FontSize="10"
                                           Foreground="#53788E" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="HandsFreeButton" Content="🎙 Bật rảnh tay" Click="HandsFree_Click"
                                        Style="{StaticResource AiAction}" Margin="0,0,9,0"/>
                                <Button x:Name="CancelMicButton" Content="■ Hủy micro" Click="CancelMicrophone_Click"
                                        Style="{StaticResource AiSecondary}"/>
                                <TextBlock x:Name="HandsFreeStatus" Text="Rảnh tay đang tắt" Foreground="#365F78"
                                           FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="BackgroundListeningCheck" Content="Cho An tiếp tục rảnh tay khi thu nhỏ HISA xuống khay hệ thống"
                                      FontSize="11" Foreground="#365F78" IsChecked="False" Margin="0,8,0,0"/>
                            <TextBlock Text="An chỉ nghe khi bạn bật rảnh tay và đồng ý gửi âm thanh tới Gemini. Thu nhỏ xuống khay hệ thống không tự tắt micro; mở lại hoặc tắt rảnh tay để dừng. Không tự bật khi mở HISA."
                                       Foreground="#53788E" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="Giọng An ưu tiên nữ tiếng Việt cài trên Windows. Giọng Hà Nội chuẩn còn phụ thuộc gói giọng nói được cài."
                                       Foreground="#53788E" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>